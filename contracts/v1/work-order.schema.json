{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-plan.local/contracts/v1/work-order.schema.json",
  "title": "Hive Plan Work Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "artifact_id", "artifact_digest", "project_id", "increment_id", "context_lock", "risk_class", "objective", "scope", "out_of_scope", "requirements", "architecture_rules", "constraints", "acceptance_criteria", "tests", "deliverables", "evidence_obligations", "review_format", "stop_condition", "created_at", "producer"],
  "properties": {
    "artifact_type": {"const": "work_order"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifactId"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "increment_id": {"$ref": "common.schema.json#/$defs/incrementId"},
    "context_lock": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "risk_class": {"$ref": "common.schema.json#/$defs/riskClass"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 5000},
    "context_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactRef"}, "uniqueItems": true},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "files_sources_to_read": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "architecture_rules": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "prior_failure_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_id", "constraint"],
        "properties": {
          "failure_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "constraint": {"type": "string", "minLength": 1, "maxLength": 2000},
          "source_ref": {"$ref": "common.schema.json#/$defs/artifactRef"}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "verification": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "tests": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "evidence_obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "review_format": {"type": "string", "minLength": 1, "maxLength": 2000},
    "stop_condition": {"type": "string", "minLength": 1, "maxLength": 3000},
    "branch": {"type": ["string", "null"], "maxLength": 200},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {"$ref": "common.schema.json#/$defs/producer"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
