{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-plan.local/contracts/v1/implementation-blueprint.schema.json",
  "title": "Hive Plan Implementation Blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","schema_version","artifact_id","artifact_digest","project_id","increment_id","work_order_ref","context_lock_ref","guidance_level","objective","scope","out_of_scope","change_surface","file_plan","symbol_plan","contracts","test_plan","evidence_plan","decision_budget","stop_condition","created_at","producer"],
  "properties": {
    "artifact_type": {"const": "implementation_blueprint"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifactId"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "increment_id": {"$ref": "common.schema.json#/$defs/incrementId"},
    "work_order_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "context_lock_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "guidance_level": {"type": "string", "enum": ["G0","G1","G2","G3"]},
    "objective": {"type": "string", "minLength": 1, "maxLength": 5000},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "must_not_touch": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "change_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_touch","likely_touch","watch_only"],
      "properties": {
        "must_touch": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "likely_touch": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "watch_only": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "file_plan": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path","operation","reason"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 500}, "operation": {"type": "string", "enum": ["CREATE","UPDATE","DELETE","INSPECT"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}}}},
    "symbol_plan": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol","responsibility"], "properties": {"symbol": {"type": "string", "minLength": 1, "maxLength": 500}, "expected_signature": {"type": ["string","null"], "maxLength": 1500}, "responsibility": {"type": "string", "minLength": 1, "maxLength": 2000}}}},
    "data_flow": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "algorithm_plan": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 3000}},
    "contracts": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 3000}},
    "error_handling": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "edge_cases": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "failure_shield": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "test_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "evidence_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "observability": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "performance_budgets": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "decision_budget": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["class","statement"], "properties": {"class": {"type": "string", "enum": ["FROZEN","BOUNDED","OPEN_LOCAL","ESCALATE"]}, "statement": {"type": "string", "minLength": 1, "maxLength": 2500}, "criterion": {"type": ["string","null"], "maxLength": 2000}}}},
    "implementation_sequence": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "stop_condition": {"type": "string", "minLength": 1, "maxLength": 3000},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {"$ref": "common.schema.json#/$defs/producer"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
