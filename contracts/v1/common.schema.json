{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-plan.local/contracts/v1/common.schema.json",
  "title": "Hive Plan Common Contract Definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "incrementId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "riskClass": {
      "type": "string",
      "enum": ["LOW", "STANDARD", "ELEVATED", "HIGH_ASSURANCE"]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["operator", "hive-plan-agent", "executor", "ci", "tool", "migration"]
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "maxLength": 80},
        "model_profile": {"type": "string", "maxLength": 80}
      }
    },
    "sourceFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "authority", "fingerprint"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "source_type": {
          "type": "string",
          "enum": ["checkpoint", "decision", "adr", "scope", "dod", "architecture", "requirement", "contract", "git_file", "git_commit", "work_order", "evidence", "tool_fact", "memory_pattern"]
        },
        "authority": {
          "type": "string",
          "enum": ["CANONICAL", "VERIFIED_FACT", "ADVISORY", "CLAIM"]
        },
        "repository": {"type": "string", "maxLength": 200},
        "path": {"type": "string", "maxLength": 500},
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "fingerprint": {"$ref": "#/$defs/digest"},
        "critical": {"type": "boolean", "default": false}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "artifact_digest"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/artifactId"},
        "artifact_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "location": {"type": "string", "maxLength": 500},
        "local_only": {"type": "boolean", "default": false}
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIP", "NOT_APPLICABLE", "UNKNOWN"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 300},
        "duration_ms": {"type": "integer", "minimum": 0},
        "details_ref": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "severity", "summary", "status"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "severity": {"type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {"type": "string", "enum": ["OPEN", "RESOLVED", "ACCEPTED", "FALSE_POSITIVE"]},
        "source": {"type": "string", "maxLength": 300},
        "requirement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
