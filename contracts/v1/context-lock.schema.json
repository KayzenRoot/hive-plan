{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-plan.local/contracts/v1/context-lock.schema.json",
  "title": "Hive Plan Context Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "artifact_id", "artifact_digest", "project_id", "increment_id", "repository", "base_sha", "sources", "context_root", "created_at", "producer"],
  "properties": {
    "artifact_type": {"const": "context_lock"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifactId"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "increment_id": {"$ref": "common.schema.json#/$defs/incrementId"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "base_sha": {"$ref": "common.schema.json#/$defs/gitSha"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/sourceFingerprint"}
    },
    "context_root": {"$ref": "common.schema.json#/$defs/digest"},
    "expires_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {"$ref": "common.schema.json#/$defs/producer"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
