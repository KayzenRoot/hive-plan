{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-plan.local/contracts/v1/workstream-checkpoint.schema.json",
  "title": "Hive Plan Workstream Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","schema_version","checkpoint_id","project_id","repository","workstream_id","workstream_kind","source_branch","source_commit_sha","project_phase","current_objective","canonical_sources","completed_since_previous","remaining_scope","blockers","known_risks","next_recommended_action","stop_condition","context_lock_state","resume_policy","created_at","producer"],
  "properties": {
    "artifact_type": {"const": "workstream_checkpoint"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "checkpoint_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "repository": {"type": "string", "minLength": 1, "maxLength": 300},
    "workstream_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "workstream_kind": {"type": "string", "enum": ["PLANNING","IMPLEMENTATION","REVIEW","RELEASE","MAINTENANCE","RESEARCH"]},
    "source_branch": {"type": "string", "minLength": 1, "maxLength": 220},
    "source_commit_sha": {"$ref": "common.schema.json#/$defs/gitSha"},
    "project_phase": {"type": "string", "enum": ["IDEA","DISCOVERY","PLANNING","PLANNING_FROZEN","IMPLEMENTATION","VALIDATION","RELEASE_CANDIDATE","RELEASED","MAINTENANCE"]},
    "current_objective": {"type": "string", "minLength": 1, "maxLength": 5000},
    "active_issue_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "active_work_order_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 160}, "uniqueItems": true},
    "active_pr_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "canonical_sources": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/artifactRef"}},
    "frozen_decisions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "unresolved_decisions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "completed_since_previous": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "remaining_scope": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "known_risks": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "failure_patterns_relevant": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "next_recommended_action": {"type": "string", "minLength": 1, "maxLength": 3000},
    "stop_condition": {"type": "string", "minLength": 1, "maxLength": 3000},
    "context_lock_state": {"type": "string", "enum": ["NOT_APPLICABLE","FRESH","STALE","UNKNOWN"]},
    "last_verified_github_watermark": {"type": ["string","null"], "maxLength": 300},
    "resume_policy": {"type": "string", "enum": ["SAFE_CONTINUE","RECONCILE_REQUIRED","STALE_CONTEXT_LOCK","BLOCKED"]},
    "supersedes_checkpoint_id": {"type": ["string","null"], "maxLength": 160},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {"$ref": "common.schema.json#/$defs/producer"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
