{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-plan.local/contracts/v1/review-receipt.schema.json",
  "title": "Hive Plan Review Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "artifact_id", "artifact_digest", "project_id", "increment_id", "risk_class", "work_order", "context_lock", "evidence_bundle", "repository", "head_sha", "context_root", "evidence_root", "verdict", "findings", "policy_profile", "created_at", "producer"],
  "properties": {
    "artifact_type": {"const": "review_receipt"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifactId"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "increment_id": {"$ref": "common.schema.json#/$defs/incrementId"},
    "risk_class": {"$ref": "common.schema.json#/$defs/riskClass"},
    "work_order": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "context_lock": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "evidence_bundle": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pull_request_number": {"type": ["integer", "null"], "minimum": 1},
    "head_sha": {"$ref": "common.schema.json#/$defs/gitSha"},
    "context_root": {"$ref": "common.schema.json#/$defs/digest"},
    "evidence_root": {"$ref": "common.schema.json#/$defs/digest"},
    "verdict": {"type": "string", "enum": ["APPROVED", "CORRECTION_REQUIRED", "BLOCKED"]},
    "findings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding"}},
    "specialist_reviews": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactRef"}},
    "policy_profile": {"type": "string", "minLength": 1, "maxLength": 120},
    "policy_version": {"type": "string", "maxLength": 80},
    "checkpoint_delta_ref": {"anyOf": [{"$ref": "common.schema.json#/$defs/artifactRef"}, {"type": "null"}]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {"$ref": "common.schema.json#/$defs/producer"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
