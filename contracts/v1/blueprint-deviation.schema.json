{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive-plan.local/contracts/v1/blueprint-deviation.schema.json",
  "title": "Hive Plan Blueprint Deviation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","schema_version","artifact_id","artifact_digest","project_id","increment_id","blueprint_ref","work_order_ref","expected_state","actual_state","reason","evidence","impact","resolution","created_at","producer"],
  "properties": {
    "artifact_type": {"const": "blueprint_deviation"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifactId"},
    "artifact_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "project_id": {"$ref": "common.schema.json#/$defs/projectId"},
    "increment_id": {"$ref": "common.schema.json#/$defs/incrementId"},
    "blueprint_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "work_order_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "expected_state": {"type": "string", "minLength": 1, "maxLength": 3000},
    "actual_state": {"type": "string", "minLength": 1, "maxLength": 3000},
    "reason": {"type": "string", "minLength": 1, "maxLength": 3000},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope","contracts","tests","context_lock"],
      "properties": {
        "scope": {"type": "string", "enum": ["NONE","LOCAL","MATERIAL","SCOPE_EXPANSION"]},
        "contracts": {"type": "string", "enum": ["UNCHANGED","AFFECTED"]},
        "tests": {"type": "string", "enum": ["UNCHANGED","ADDITIONAL_REQUIRED","INVALIDATED"]},
        "context_lock": {"type": "string", "enum": ["FRESH","REVALIDATE","STALE"]}
      }
    },
    "resolution": {"type": "string", "enum": ["SAFE_LOCAL_CORRECTION","RECOMPILE_BLUEPRINT","RECOMPILE_WORK_ORDER","ESCALATE_BLOCKED"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {"$ref": "common.schema.json#/$defs/producer"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
